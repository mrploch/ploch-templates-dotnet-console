<?xml version="1.0" encoding="utf-8"?>

<!--
    Central package management: every package version used in the repository is pinned here.
    Versions are aligned with mrploch-development/dependencies/*.Packages.props; Dependabot keeps them current.
-->
<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup Label="Build">
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    </ItemGroup>

    <ItemGroup Label="Application">
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageVersion Include="Ploch.Common" Version="4.0.47" />
        <PackageVersion Include="Spectre.Console" Version="0.57.2" />
        <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageVersion Include="AutoFixture.Xunit3" Version="4.19.0" />
        <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
        <PackageVersion Include="FluentAssertions" Version="8.10.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup Label="Analysers">
        <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401" />
        <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
        <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
        <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.1.118" />
    </ItemGroup>
</Project>
